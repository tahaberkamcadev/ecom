# In a real deployment these values would be injected via a secret manager
# and never get committed to the repository.
# For local development and demo purposes the defaults below are intentionally
# filled in so the stack can be started with a single command:
# cp .env.example .env && docker compose up -d --build


USER_DB_NAME=userservicedb
USER_DB_USER=myuser
USER_DB_PASSWORD=secret

INVENTORY_DB_NAME=inventorydb
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=inventory

ORDER_DB_NAME=orderdb
ORDER_DB_USER=order
ORDER_DB_PASSWORD=order

PAYMENT_DB_NAME=paymentdb
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=payment

REVIEW_DB_NAME=reviewdb
REVIEW_DB_USER=review
REVIEW_DB_PASSWORD=review

PROJECTION_DB_NAME=projectiondb
PROJECTION_DB_USER=projection
PROJECTION_DB_PASSWORD=projection

# JWT (256-bit hex)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Shared between api-gateway and header-trusting backend services (inventory, review, projection)
GATEWAY_SECRET=7a9f3c2e1b4d8f6a0e5c9b2d7f4a1e8c3b6d9f2a5e8c1b4d7f0a3e6c9b2d5f8
